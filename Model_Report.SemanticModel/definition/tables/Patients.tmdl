/// One row per patient referred into Tobii Dynavox's AAC device program. Tracks the referral-to-delivery pipeline, post-delivery revenue, NPS feedback, and retention status. Grain: one row per Patient ID. Source: '02 Data' sheet of Model_1.xlsx (synthetic data, 180 records).
table Patients
	lineageTag: b1d482f9-4e89-4c2f-944c-9a99f7cc950d

	/// Unique identifier for the patient record, as assigned by the CRM system.
	column 'Patient ID'
		dataType: string
		lineageTag: 6d269d6b-3ae4-436b-9688-abf46296b89f
		summarizeBy: none
		sourceColumn: Patient ID

	column 'Referral Date'
