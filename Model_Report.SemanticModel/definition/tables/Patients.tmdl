		lineageTag: 483c31d6-95ba-4dda-ad0e-cfd911d53d02
		summarizeBy: sum
		sourceColumn: Account Manager Touchpoints

	/// Elapsed calendar days from referral to device delivery.
	column 'Time To Device (Days)'
		dataType: int64
