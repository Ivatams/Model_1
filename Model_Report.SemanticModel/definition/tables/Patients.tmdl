	column 'Patient Status Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: c8678311-cd6a-4ad0-abb1-c2c68291820b
		summarizeBy: none
		sourceColumn: Patient Status Key

	column 'Churn Reason Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: c6aac024-2f63-4320-9601-b1f275ac17e0
		summarizeBy: none
		sourceColumn: Churn Reason Key

	partition Patients = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("c:\Users\HP\Desktop\Tobii_Dynavox\Power_BI\Model_1\Model_1.xlsx"), null, true),
				    Sheet = Source{[Item="02 Data",Kind="Sheet"]}[Data],
				    DataRows = Table.Skip(Sheet, 4),
				    Renamed = Table.RenameColumns(DataRows, {
				        {"Column1", "Patient ID"}, {"Column2", "Referral Channel"}, {"Column3", "Diagnosis"},
				        {"Column4", "Funding Pathway"}, {"Column5", "Speech Language Pathologist ID"}, {"Column6", "Account Manager ID"},
				        {"Column7", "Account Manager Touchpoints"}, {"Column8", "Referral Date"}, {"Column9", "SLP Evaluation Done"},
				        {"Column10", "Trial Arranged"}, {"Column11", "Trial Completed"}, {"Column12", "Application Submitted"},
				        {"Column13", "Funding Approved"}, {"Column14", "Device Delivered"}, {"Column15", "Delivery Date"},
				        {"Column16", "Time To Device (Days)"}, {"Column17", "Device Value"}, {"Column18", "Software Revenue"},
				        {"Column19", "Accessories Revenue"}, {"Column20", "Total First Year Value"}, {"Column21", "Post-Delivery Touchpoints"},
				        {"Column22", "NPS TD.com"}, {"Column23", "NPS E-Funding"}, {"Column24", "NPS Post Funding Case"},
				        {"Column25", "NPS Post Support"}, {"Column26", "NPS MYTD"}, {"Column27", "Patient Status"},
				        {"Column28", "Last Engagement Date"}, {"Column29", "Churn Reason"}, {"Column30", "Months Active Post Delivery"}
				    }),
				    FilteredRows = Table.SelectRows(Renamed, each [Patient ID] <> null and [Patient ID] <> ""),
				    PlaceholderCols = {"Delivery Date","Time To Device (Days)","Device Value","Software Revenue","Accessories Revenue","Total First Year Value","Post-Delivery Touchpoints","Patient Status","Last Engagement Date","Churn Reason","Months Active Post Delivery","Account Manager ID"},
				    ReplacedDash = Table.ReplaceValue(FilteredRows, "—", null, Replacer.ReplaceValue, PlaceholderCols),
				    ReplacedNA = Table.ReplaceValue(ReplacedDash, "n/a", null, Replacer.ReplaceValue, PlaceholderCols),
				    MonthLookup = {"Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"},
				    ParsedReferralDate = Table.TransformColumns(ReplacedNA, {{"Referral Date", each let p = Text.Split(_, "-") in #date(Number.FromText(p{2}), List.PositionOf(MonthLookup, p{1}) + 1, Number.FromText(p{0})), type date}}),
				    ParsedDeliveryDate = Table.TransformColumns(ParsedReferralDate, {{"Delivery Date", each if _ = null then null else let p = Text.Split(_, "-") in #date(Number.FromText(p{2}), List.PositionOf(MonthLookup, p{1}) + 1, Number.FromText(p{0})), type date}}),
				    ParsedLastEngagement = Table.TransformColumns(ParsedDeliveryDate, {{"Last Engagement Date", each if _ = null then null else Date.FromText(_), type date}}),
				    ChangedTypes = Table.TransformColumnTypes(ParsedLastEngagement, {
				        {"Patient ID", type text}, {"Referral Channel", type text}, {"Diagnosis", type text}, {"Funding Pathway", type text},
				        {"Speech Language Pathologist ID", type text}, {"Account Manager ID", type text}, {"Account Manager Touchpoints", Int64.Type},
				        {"SLP Evaluation Done", type text}, {"Trial Arranged", type text}, {"Trial Completed", type text}, {"Application Submitted", type text},
				        {"Funding Approved", type text}, {"Device Delivered", type text}, {"Time To Device (Days)", Int64.Type},
				        {"Device Value", Int64.Type}, {"Software Revenue", Int64.Type}, {"Accessories Revenue", Int64.Type},
				        {"Total First Year Value", Int64.Type}, {"Post-Delivery Touchpoints", Int64.Type}, {"NPS TD.com", Int64.Type},
				        {"NPS E-Funding", Int64.Type}, {"NPS Post Funding Case", Int64.Type}, {"NPS Post Support", Int64.Type},
				        {"NPS MYTD", Int64.Type}, {"Patient Status", type text}, {"Churn Reason", type text}, {"Months Active Post Delivery", Int64.Type}
				    }),
				    LookupReferralChannel = Table.AddIndexColumn(Table.Sort(Table.Distinct(Table.SelectRows(Table.SelectColumns(ChangedTypes, {"Referral Channel"}), each [Referral Channel] <> null)), {{"Referral Channel", Order.Ascending}}), "Referral Channel Key", 1, 1, Int64.Type),
				    JoinReferralChannel = Table.NestedJoin(ChangedTypes, {"Referral Channel"}, LookupReferralChannel, {"Referral Channel"}, "RC_Lookup", JoinKind.LeftOuter),
				    ExpandReferralChannel = Table.ExpandTableColumn(JoinReferralChannel, "RC_Lookup", {"Referral Channel Key"}, {"Referral Channel Key"}),
				    LookupDiagnosis = Table.AddIndexColumn(Table.Sort(Table.Distinct(Table.SelectRows(Table.SelectColumns(ChangedTypes, {"Diagnosis"}), each [Diagnosis] <> null)), {{"Diagnosis", Order.Ascending}}), "Diagnosis Key", 1, 1, Int64.Type),
				    JoinDiagnosis = Table.NestedJoin(ExpandReferralChannel, {"Diagnosis"}, LookupDiagnosis, {"Diagnosis"}, "Dx_Lookup", JoinKind.LeftOuter),
				    ExpandDiagnosis = Table.ExpandTableColumn(JoinDiagnosis, "Dx_Lookup", {"Diagnosis Key"}, {"Diagnosis Key"}),
				    LookupFundingPathway = Table.AddIndexColumn(Table.Sort(Table.Distinct(Table.SelectRows(Table.SelectColumns(ChangedTypes, {"Funding Pathway"}), each [Funding Pathway] <> null)), {{"Funding Pathway", Order.Ascending}}), "Funding Pathway Key", 1, 1, Int64.Type),
				    JoinFundingPathway = Table.NestedJoin(ExpandDiagnosis, {"Funding Pathway"}, LookupFundingPathway, {"Funding Pathway"}, "FP_Lookup", JoinKind.LeftOuter),
				    ExpandFundingPathway = Table.ExpandTableColumn(JoinFundingPathway, "FP_Lookup", {"Funding Pathway Key"}, {"Funding Pathway Key"}),
				    LookupSLP = Table.AddIndexColumn(Table.Sort(Table.Distinct(Table.SelectRows(Table.SelectColumns(ChangedTypes, {"Speech Language Pathologist ID"}), each [Speech Language Pathologist ID] <> null)), {{"Speech Language Pathologist ID", Order.Ascending}}), "Speech Language Pathologist Key", 1, 1, Int64.Type),
				    JoinSLP = Table.NestedJoin(ExpandFundingPathway, {"Speech Language Pathologist ID"}, LookupSLP, {"Speech Language Pathologist ID"}, "SLP_Lookup", JoinKind.LeftOuter),
				    ExpandSLP = Table.ExpandTableColumn(JoinSLP, "SLP_Lookup", {"Speech Language Pathologist Key"}, {"Speech Language Pathologist Key"}),
				    LookupAM = Table.AddIndexColumn(Table.Sort(Table.Distinct(Table.SelectRows(Table.SelectColumns(ChangedTypes, {"Account Manager ID"}), each [Account Manager ID] <> null)), {{"Account Manager ID", Order.Ascending}}), "Account Manager Key", 1, 1, Int64.Type),
				    JoinAM = Table.NestedJoin(ExpandSLP, {"Account Manager ID"}, LookupAM, {"Account Manager ID"}, "AM_Lookup", JoinKind.LeftOuter),
				    ExpandAM = Table.ExpandTableColumn(JoinAM, "AM_Lookup", {"Account Manager Key"}, {"Account Manager Key"}),
				    LookupPatientStatus = Table.AddIndexColumn(Table.Sort(Table.Distinct(Table.SelectRows(Table.SelectColumns(ChangedTypes, {"Patient Status"}), each [Patient Status] <> null)), {{"Patient Status", Order.Ascending}}), "Patient Status Key", 1, 1, Int64.Type),
				    JoinPatientStatus = Table.NestedJoin(ExpandAM, {"Patient Status"}, LookupPatientStatus, {"Patient Status"}, "PS_Lookup", JoinKind.LeftOuter),
				    ExpandPatientStatus = Table.ExpandTableColumn(JoinPatientStatus, "PS_Lookup", {"Patient Status Key"}, {"Patient Status Key"}),
				    LookupChurnReason = Table.AddIndexColumn(Table.Sort(Table.Distinct(Table.SelectRows(Table.SelectColumns(ChangedTypes, {"Churn Reason"}), each [Churn Reason] <> null)), {{"Churn Reason", Order.Ascending}}), "Churn Reason Key", 1, 1, Int64.Type),
				    JoinChurnReason = Table.NestedJoin(ExpandPatientStatus, {"Churn Reason"}, LookupChurnReason, {"Churn Reason"}, "CR_Lookup", JoinKind.LeftOuter),
				    ExpandChurnReason = Table.ExpandTableColumn(JoinChurnReason, "CR_Lookup", {"Churn Reason Key"}, {"Churn Reason Key"}),
				    RemovedTextColumns = Table.RemoveColumns(ExpandChurnReason, {"Referral Channel", "Diagnosis", "Funding Pathway", "Speech Language Pathologist ID", "Account Manager ID", "Patient Status", "Churn Reason"})
				in
				    RemovedTextColumns

